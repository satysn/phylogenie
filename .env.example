# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# Required: NCBI requires a contact email for Entrez / BLAST requests.
NCBI_EMAIL=your_email@example.com

# Optional but recommended: 10x higher NCBI rate limits.
# Get one free at https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# Storage
OUTPUT_DIR=outputs
DB_PATH=phylogenie.db

# Job limits
MAX_SEQUENCES=10
JOB_RETENTION_DAYS=30
MAX_CONCURRENT_JOBS=3

# BLAST
BLAST_HITLIST_SIZE=20
BLAST_EXPECT=0.001
BLAST_TIMEOUT_SECONDS=180

# Augustus web gene predictor
AUGUSTUS_URL=https://bioinf.uni-greifswald.de/augustus/submission.php
AUGUSTUS_POLL_ATTEMPTS=12
AUGUSTUS_POLL_INTERVAL=10

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=false
# Comma-separated list of allowed origins, or * for any
CORS_ORIGINS=*
LOG_LEVEL=INFO

# Requests per minute allowed per client IP
RATE_LIMIT_PER_MINUTE=30
